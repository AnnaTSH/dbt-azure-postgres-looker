dbt_azure_postgres_looker:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_PORT', '5432') | int }}"
      user: "{{ env_var('DBT_USER', 'postgres') }}"
      password: "{{ env_var('DBT_PASSWORD', 'postgres') }}"
      dbname: "{{ env_var('DBT_DBNAME', 'superstore') }}"
      schema: public
      threads: 4
      sslmode: "{{ env_var('DBT_SSLMODE', 'disable') }}"

    azure:
      type: postgres
      host: "{{ env_var('AZURE_POSTGRES_HOST') }}"
      port: "{{ env_var('AZURE_POSTGRES_PORT', '5432') | int }}"
      user: "{{ env_var('AZURE_POSTGRES_USER') }}"
      password: "{{ env_var('AZURE_POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('AZURE_POSTGRES_DB') }}"
      schema: public
      threads: 4
      sslmode: require
